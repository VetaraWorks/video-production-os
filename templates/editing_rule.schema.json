{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "editing_rule v2",
  "description": "人工批准、完整性绑定且默认 inactive 的正式 editing rule；只有精确 revision 经人工 activation 后才可作为 Planner advisory。",
  "type": "object",
  "required": [
    "schema_version", "rule_id", "revision", "version", "lineage_id",
    "source_candidate_id", "source_candidate", "review_id", "review_hash",
    "evidence_ids", "evidence_snapshot", "rule_class", "category", "rule_type",
    "scope", "expression", "metric", "field", "operator", "value",
    "description", "status", "active", "confidence_at_approval", "approval",
    "provenance", "content_hash", "lifecycle", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "rule_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "lineage_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate": {
      "type": "object",
      "required": ["candidate_id", "lineage_id", "revision", "content_hash"],
      "properties": {
        "candidate_id": {"type": "string"},
        "lineage_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "review_id": {"type": "string"},
    "review_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind", "evidence_id", "action_id", "source_ref", "source_file",
          "project_id", "project", "run_id", "evidence_tier", "gate_material_digest"
        ],
        "properties": {
          "kind": {"const": "production_evidence"},
          "evidence_id": {"type": "string"},
          "action_id": {"type": "string"},
          "source_ref": {"type": "string"},
          "source_file": {"type": "string"},
          "project_id": {"type": "string"},
          "project": {"type": "string"},
          "run_id": {"type": "string"},
          "evidence_tier": {"const": "production_verified"},
          "gate_material_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rule_class": {"const": "editing"},
    "category": {"type": "string"},
    "rule_type": {"enum": ["timing", "rhythm", "shot_selection"]},
    "type": {"enum": ["quantitative", "qualitative"]},
    "scope": {"type": "object"},
    "expression": {"type": "object", "minProperties": 1},
    "metric": {"type": ["string", "null"]},
    "field": {"type": "string"},
    "operator": {"type": "string"},
    "value": {},
    "description": {"type": "string"},
    "status": {"enum": ["active", "inactive", "deprecated", "revoked", "superseded"]},
    "active": {"type": "boolean"},
    "activation": {
      "type": "object",
      "required": [
        "reviewer", "reason", "rule_id", "rule_revision",
        "rule_content_hash", "review_id", "activated_at", "application_mode"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_revision": {"type": "integer", "minimum": 1},
        "rule_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_id": {"type": "string", "minLength": 1},
        "activated_at": {"type": "string", "minLength": 1},
        "application_mode": {"const": "advisory"}
      }
    },
    "confidence_at_approval": {"type": "number", "minimum": 0, "maximum": 1},
    "approval": {
      "type": "object",
      "required": ["review_id", "reviewer", "reason"],
      "properties": {
        "review_id": {"type": "string"},
        "reviewer": {"type": "string"},
        "reason": {"type": "string"},
        "scope_adjustment": {"type": ["object", "null"]},
        "conflict_resolution": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "candidate_id", "candidate_revision", "candidate_content_hash",
        "review_id", "review_hash", "evidence_ids"
      ]
    },
    "content_hash": {
      "type": "object",
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": {"const": "video-os-editing-rule-v2"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "revision", "history"],
      "properties": {
        "status": {"enum": ["active", "inactive", "deprecated", "revoked", "superseded"]},
        "revision": {"type": "integer", "minimum": 1},
        "history": {"type": "array", "minItems": 1}
      }
    },
    "supersedes": {"type": ["object", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "evidence_status": {"enum": ["valid", "source_missing", "needs_review", null]},
    "conflicts_with": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {"required": ["activation"]}
    }
  ]
}
